## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The NuGet packages folder
.nuget/

# User-specific launch settings (IDE launch profiles)
*.launchSettings.json

# User-specific files
*.user
*.userosscache
*.suo
*.userprefs

# Visual Studio / VS Code / Rider IDE state
.vs/
.vscode/
.idea/
*.sln.docstates

# Build / publish web deployment settings
*.publishsettings
*.pubxml
*.publishproj

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Code coverage results
CodeCoverage/
[Cc]overage*
*.coverage
*.coveragexml
*.dotCover
*.ncrunch*
.*crunch*.local.xml

# Diagnostic / log files
*.log
*.tlog
*.svclog
*.pidb

# Temporary / backup files
*.tmp
*.temp
*.bak
*.old

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# dotenv environment variables file
.env
.env.*
!.env.example

# Editor swap / backup files
*.swp
*.swo
*~

# Office temp files
~$*

# AI agent local state (opencode)
.agents/
skills-lock.json

# Local PowerShell helper scripts
*.ps1

# Local NuGet feed credentials (never commit)
nuget.config
NuGet.Config
