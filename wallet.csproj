<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Npgsql.EnableGSSAPI" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Contracts" Version="*" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="ProtoValidate" Version="1.0.1" />
    <PackageReference Include="SpreadCheetah" Version="1.28.0" />
  </ItemGroup>

</Project>
